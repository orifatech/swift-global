---
import { COMPANY, SERVICES, SECTORS } from '@/data/companyData';
---

<footer class="bg-obsidian-950 border-t border-obsidian-800 text-white relative overflow-hidden" role="contentinfo">
  
  <!-- Subtle Industrial Glow in Background -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-amber-glow/5 filter blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Main Corporate Footer Grid -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 py-16 lg:py-20 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-14">
      
      <!-- Col 1: Corporate Profile & Logos -->
      <div class="space-y-4">
        <div class="h-12 w-auto flex items-center">
          <img
            src={COMPANY.logoSvg}
            alt={COMPANY.legalName}
            width="280"
            height="62"
            class="h-10 w-auto object-contain"
            loading="lazy"
          />
        </div>

        <p class="text-sm text-slate-300 leading-relaxed font-sans max-w-md">
          {COMPANY.description}
        </p>

        <!-- Technical Accreditations & Standards -->
        <div class="space-y-2">
          <div class="text-[10px] font-mono uppercase tracking-architect text-amber-gold">
            Procurement &amp; EPC Governance Standards:
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-[11px] text-slate-300">
            <span class="px-2.5 py-1 rounded-md bg-obsidian-900 border border-obsidian-750">ISO 9001:2015</span>
            <span class="px-2.5 py-1 rounded-md bg-obsidian-900 border border-obsidian-750">ASME Sec. VIII</span>
            <span class="px-2.5 py-1 rounded-md bg-obsidian-900 border border-obsidian-750">API 650 / 510</span>
            <span class="px-2.5 py-1 rounded-md bg-obsidian-900 border border-obsidian-750">Incoterms 2020</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div class="space-y-4">
        <h4 class="font-display font-bold uppercase tracking-wider text-xs text-amber-gold">
          Core Capabilities
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-300">
          {SERVICES.map((service) => (
            <li>
              <a href={`/services#service-${service.number}`} class="hover:text-amber-gold transition-colors block">
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Sectors & Regional Hubs -->
      <div class="space-y-4">
        <h4 class="font-display font-bold uppercase tracking-wider text-xs text-amber-gold">
          Sectors &amp; Hubs
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-300">
          {SECTORS.map((sector) => (
            <li>
              <a href="/sectors" class="hover:text-amber-gold transition-colors block">
                {sector.title}
              </a>
            </li>
          ))}
          <li class="pt-2 text-[11px] font-mono text-slate-400">
            Operating Hubs:
          </li>
          <li class="text-[11px] font-mono text-slate-300">
            Toronto | Houston | Dubai | Lagos
          </li>
        </ul>
      </div>

      <!-- Col 4: Corporate Headquarters -->
      <div class="col-span-full space-y-4 font-mono text-xs">
        <h4 class="font-display font-bold uppercase tracking-wider text-xs text-amber-gold">
          Corporate Dispatch
        </h4>
        <div class="space-y-2 text-slate-300 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Corporate HQ</span>
            <strong class="text-white font-semibold">1000 King Street West</strong><br />
            Toronto, ON, M6K 3N1, Canada
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Direct Dispatch</span>
            <a href="tel:+15875663166" class="text-white hover:text-amber-gold transition-colors font-semibold">
              +1 (587) 566-3166
            </a>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Official RFQ Email</span>
            <a href={`mailto:${COMPANY.email}`} class="text-amber-gold hover:underline">
              {COMPANY.email}
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Continuum Bar -->
    <div class="mt-14 pt-8 border-t border-obsidian-850 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div>
        © {new Date().getFullYear()} {COMPANY.legalName} All rights reserved.
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span>Engineering Procurement &amp; Turnkey EPC</span>
      </div>
    </div>
  </div>
</footer>
