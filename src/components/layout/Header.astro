---
import Button from '@/components/ui/Button.astro';
import { COMPANY } from '@/data/companyData';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const sister = COMPANY.sisterCompany;
---

<header class="sticky top-0 z-50 transition-colors duration-200">
  
  <!-- Sister Entity Referral Banner -->
  <div class="bg-obsidian-950 border-b border-obsidian-800 text-xs font-mono py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 text-[11px]">
        <span class="w-2 h-2 rounded-full bg-amber-gold animate-pulse shadow-[0_0_8px_#D4AF37]"></span>
        <span class="text-slate-400 uppercase tracking-widest text-[10px]">Active Website:</span>
        <strong class="text-white font-semibold">Swift Global Inc.</strong>
        <span class="text-slate-600 hidden sm:inline">|</span>
        <span class="text-slate-400 hidden sm:inline">International EPC &amp; Procurement</span>
      </div>

      <!-- Sister Company Switcher Link -->
      <a
        href={sister.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-steel-900/90 hover:bg-steel-800 text-steel-200 hover:text-white border border-steel-700 hover:border-steel-400 transition-all text-[11px] font-semibold tracking-wide group shadow-sm"
        aria-label={`Visit sister company ${sister.name}`}
      >
        <span>Sister Practice: <strong class="text-white">{sister.name}</strong> ({sister.subtitle})</span>
        <span class="text-amber-gold group-hover:translate-x-0.5 transition-transform" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="bg-obsidian-950/85 backdrop-blur-xl border-b border-obsidian-800/80 shadow-dark-card" aria-label="Main Navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Brand Logo -->
        <a
          href="/"
          class="flex items-center py-2 group focus-visible:outline-amber-gold rounded-lg"
          aria-label="Swift Global Inc. Home"
        >
          <div class="h-10 sm:h-12 w-auto flex items-center">
            <img
              src="/images/swift-global-logo.svg"
              alt="Swift Global Inc."
              width="260"
              height="58"
              class="h-9 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </a>

        <!-- Desktop Navigation Items -->
        <div class="hidden lg:flex items-center space-x-1">
          {COMPANY.navLinks.map((link) => {
            const isHome = link.href === '/';
            const isActive = isHome ? activePath === '/' : activePath.startsWith(link.href);
            
            return (
              <a
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
                class={`px-4 py-2 rounded-lg text-xs font-display font-semibold uppercase tracking-wider transition-all duration-200 ${
                  isActive
                    ? 'text-amber-gold bg-amber-950/40 border border-amber-500/40 shadow-[0_0_15px_rgba(212,175,55,0.15)]'
                    : 'text-slate-300 hover:text-white hover:bg-obsidian-850/80'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </div>

        <!-- Right Action Hub: Toronto Dispatch & RFP Button -->
        <div class="hidden sm:flex items-center gap-4">
          <a
            href="tel:+15875663166"
            class="flex flex-col text-right font-mono group focus-visible:outline-amber-gold rounded-lg px-2 py-1"
            aria-label="Call Toronto dispatch at +1 (587) 566-3166"
          >
            <span class="text-[10px] uppercase tracking-wider text-slate-400">
              Toronto Dispatch
            </span>
            <span class="text-xs font-semibold text-white group-hover:text-amber-gold transition-colors">
              +1 (587) 566-3166
            </span>
          </a>

          <Button href="/contact" variant="primary" size="sm">
            Submit Procurement RFP
          </Button>
        </div>

        <!-- Mobile Hamburger Button -->
        <div class="flex lg:hidden items-center gap-2">
          <a
            href="/contact"
            class="sm:hidden px-3 py-1.5 rounded-lg text-xs font-display font-bold uppercase tracking-wider bg-amber-gold text-obsidian-950 shadow-amber-glow"
          >
            RFP
          </a>
          <button
            type="button"
            id="mobile-menu-button"
            class="p-2.5 rounded-xl text-slate-200 bg-obsidian-900 border border-obsidian-750 hover:bg-obsidian-850 hover:text-white focus-visible:outline-amber-gold"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
          >
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div
      id="mobile-nav-menu"
      class="hidden lg:hidden border-t border-obsidian-800 bg-obsidian-950/98 backdrop-blur-2xl"
      role="region"
      aria-label="Mobile Navigation"
    >
      <div class="px-4 pt-4 pb-6 space-y-4">
        
        <!-- Sister Entity Callout in Mobile Drawer -->
        <div class="p-4 rounded-xl bg-obsidian-900/90 border border-obsidian-750 space-y-2">
          <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider">
            Looking for Canadian Structural Engineering?
          </div>
          <a
            href={sister.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between py-2 px-3 rounded-lg bg-steel-900 text-steel-200 hover:text-white text-xs font-mono font-bold uppercase border border-steel-700"
          >
            <span>{sister.ctaLabel}</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Links -->
        <div class="space-y-1">
          {COMPANY.navLinks.map((link) => (
            <a
              href={link.href}
              class="block px-4 py-2.5 rounded-lg text-sm font-display font-medium uppercase tracking-wider text-slate-200 hover:bg-obsidian-850 hover:text-amber-gold transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Contact Info in Mobile Drawer -->
        <div class="pt-4 border-t border-obsidian-800 font-mono text-xs text-slate-400 space-y-1.5">
          <div><strong class="text-white">Toronto HQ:</strong> 1000 King Street West</div>
          <div><strong class="text-white">Telephone:</strong> <a href="tel:+15875663166" class="text-amber-gold underline">+1 (587) 566-3166</a></div>
          <div><strong class="text-white">Email:</strong> <a href={`mailto:${COMPANY.email}`} class="text-amber-gold underline">{COMPANY.email}</a></div>
        </div>

        <div class="pt-2">
          <Button href="/contact" variant="primary" size="md" class="w-full">
            Submit Procurement RFP
          </Button>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-nav-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuButton.focus();
      }
    });
  }
</script>
