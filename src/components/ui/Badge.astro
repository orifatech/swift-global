---
interface Props {
  variant?: 'amber' | 'steel' | 'neutral';
  class?: string;
}

const { variant = 'amber', class: className = '' } = Astro.props;

const variants = {
  amber: 'bg-amber-950/80 text-amber-300 border-amber-500/40 shadow-[0_0_12px_rgba(212,175,55,0.15)]',
  steel: 'bg-steel-900/80 text-steel-200 border-steel-500/40 shadow-[0_0_12px_rgba(91,130,150,0.15)]',
  neutral: 'bg-obsidian-850 text-slate-300 border-slate-700/60'
};
---

<span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider border ${variants[variant]} ${className}`}>
  <slot />
</span>
