---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { COMPANY } from '@/data/companyData';

const sister = COMPANY.sisterCompany;
---

<Layout
  title="Submit Procurement RFP | Swift Global Inc."
  description="Contact Swift Global Inc. for technical equipment sourcing, Factory Acceptance Testing (FAT), heavy industrial plant upgrades, and turnkey EPC delivery."
  activePath="/contact"
>
  <!-- Page Header -->
  <section class="bg-obsidian-950 text-white py-16 lg:py-24 border-b border-obsidian-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="amber">Direct Engagement</Badge>
          <span class="font-mono text-xs text-slate-400">Toronto • Dubai • Lagos</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Procurement RFQ &amp; Project Inquiry
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Submit your equipment schedules, technical specifications, or turnkey EPC requirements. Our engineering procurement team responds within 24 business hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Contact Grid -->
  <section class="py-20 lg:py-28 bg-obsidian-900 text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: RFP Form -->
        <div class="lg:col-span-7 glass-card rounded-2xl p-6 sm:p-10 space-y-6">
          <div class="space-y-2">
            <h2 class="text-2xl font-display font-bold uppercase text-white">
              Procurement Request Form
            </h2>
            <p class="text-xs font-mono text-slate-400">
              Complete the fields below to initiate technical bid leveling or scope review.
            </p>
          </div>

          <form id="global-rfp-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-name" class="block text-xs font-mono uppercase text-slate-300">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="e.g. Marcus Vance, P.Eng"
                  class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-org" class="block text-xs font-mono uppercase text-slate-300">
                  Company / Organization *
                </label>
                <input
                  type="text"
                  id="contact-org"
                  required
                  placeholder="e.g. Apex Industrial Energy Corp"
                  class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-email" class="block text-xs font-mono uppercase text-slate-300">
                  Corporate Email *
                </label>
                <input
                  type="email"
                  id="contact-email"
                  required
                  placeholder="name@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-phone" class="block text-xs font-mono uppercase text-slate-300">
                  Telephone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  required
                  placeholder="+1 (555) 000-0000"
                  class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="project-location" class="block text-xs font-mono uppercase text-slate-300">
                Target Project Location / Delivery Country
              </label>
              <input
                type="text"
                id="project-location"
                placeholder="e.g. UAE, Saudi Arabia, Nigeria, Canada, USA"
                class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
              />
            </div>

            <div class="space-y-2">
              <span class="block text-xs font-mono uppercase text-slate-300">
                Required Services / Scope Matrix (Select all applicable):
              </span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-sans text-slate-200">
                <label class="flex items-center gap-2 p-2.5 rounded-lg bg-obsidian-950 border border-obsidian-800 cursor-pointer hover:border-amber-gold/50">
                  <input type="checkbox" class="accent-amber-500 rounded" />
                  <span>Heavy Equipment Procurement</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-lg bg-obsidian-950 border border-obsidian-800 cursor-pointer hover:border-amber-gold/50">
                  <input type="checkbox" class="accent-amber-500 rounded" />
                  <span>Factory Acceptance Testing (FAT)</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-lg bg-obsidian-950 border border-obsidian-800 cursor-pointer hover:border-amber-gold/50">
                  <input type="checkbox" class="accent-amber-500 rounded" />
                  <span>Turnkey EPC Facility Execution</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-lg bg-obsidian-950 border border-obsidian-800 cursor-pointer hover:border-amber-gold/50">
                  <input type="checkbox" class="accent-amber-500 rounded" />
                  <span>Port Staging &amp; Global Logistics</span>
                </label>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="project-desc" class="block text-xs font-mono uppercase text-slate-300">
                Project Scope &amp; Bill of Materials (BOM) Summary *
              </label>
              <textarea
                id="project-desc"
                rows="5"
                required
                placeholder="Detail technical specifications, key machinery, required delivery Incoterms (CIF/DAP/DDP), or construction milestones..."
                class="w-full px-4 py-3 rounded-xl bg-obsidian-950 border border-obsidian-750 text-white placeholder-slate-600 focus:border-amber-gold focus:outline-none font-sans text-sm"
              ></textarea>
            </div>

            <Button type="submit" variant="primary" size="lg" class="w-full">
              Transmit Procurement Request →
            </Button>
          </form>
        </div>

        <!-- Right: Corporate Info & Sister Referral -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Dispatch Card -->
          <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
            <h3 class="text-xl font-display font-bold uppercase text-white">
              Corporate Headquarters
            </h3>

            <div class="space-y-4 font-mono text-xs text-slate-300">
              <div class="p-3.5 rounded-xl bg-obsidian-950 border border-obsidian-800 space-y-1">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">ADDRESS</span>
                <strong class="text-white text-sm">{COMPANY.address}</strong>
                <p class="text-slate-400 text-xs">Toronto, Ontario, Canada</p>
              </div>

              <div class="p-3.5 rounded-xl bg-obsidian-950 border border-obsidian-800 space-y-1">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">DIRECT TELEPHONE</span>
                <a href="tel:+15875663166" class="text-white hover:text-amber-gold text-sm font-bold block transition-colors">
                  {COMPANY.phone}
                </a>
              </div>

              <div class="p-3.5 rounded-xl bg-obsidian-950 border border-obsidian-800 space-y-1">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">OFFICIAL EMAIL</span>
                <a href={`mailto:${COMPANY.email}`} class="text-white hover:text-amber-gold text-sm font-bold block transition-colors">
                  {COMPANY.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Regional Hubs -->
          <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-4">
            <h4 class="font-display font-bold uppercase text-xs tracking-wider text-amber-gold">
              International Operations Centers
            </h4>
            <div class="space-y-3 font-mono text-xs text-slate-300">
              <div class="border-b border-obsidian-800 pb-2">
                <span class="text-white font-semibold block">Middle East Operations:</span>
                <span class="text-slate-400">Dubai &amp; Jebel Ali Hub, United Arab Emirates</span>
              </div>
              <div>
                <span class="text-white font-semibold block">West Africa EPC Center:</span>
                <span class="text-slate-400">Lekki Free Zone, Lagos, Nigeria</span>
              </div>
            </div>
          </div>

          <!-- Sister Entity Referral Box -->
          <div class="p-6 rounded-2xl bg-gradient-to-br from-steel-950 to-obsidian-900 border border-steel-700/60 space-y-3">
            <div class="flex items-center gap-2 font-mono text-[10px] uppercase text-steel-400">
              <span class="w-1.5 h-1.5 rounded-full bg-steel-400"></span>
              <span>Looking for Canadian Structural Engineering?</span>
            </div>
            <h4 class="font-display font-bold text-white text-base">
              {sister.name} ({sister.subtitle})
            </h4>
            <p class="text-xs text-slate-300 font-sans leading-relaxed">
              {sister.description}
            </p>
            <a
              href={sister.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-white bg-steel-700 hover:bg-steel-600 px-4 py-2 rounded-lg transition-colors"
            >
              <span>{sister.ctaLabel}</span>
              <span>↗</span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('global-rfp-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for submitting your procurement inquiry to Swift Global Inc. A technical director will reach out within 24 business hours.');
      form.reset();
    });
  }
</script>
