---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES, PROJECTS, GLOBAL_REGIONS } from '@/data/companyData';
---

<Layout
  title="International Engineering Procurement & Turnkey EPC"
  description="Swift Global Inc. provides heavy industrial equipment procurement, OEM vendor prequalification, petrochemical facility upgrades, and turnkey EPC execution across North America, the Middle East, and West Africa."
  activePath="/"
  preloadImage="/images/international-epc-site.webp"
  preloadImageMobile="/images/international-epc-site-mobile.webp"
>

  <!-- ==========================================
       HERO: HEAVY INDUSTRIAL POWER & GLOBAL REACH
       ========================================== -->
  <section class="relative bg-obsidian-950 text-white overflow-hidden border-b border-obsidian-800" aria-label="Swift Global Hero">
    <!-- Ambient Industrial Glow & Grid -->
    <div class="absolute inset-0 bg-industrial-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-amber-gold/10 rounded-full filter blur-[120px] pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12 py-20 sm:py-28 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-3">
            <Badge variant="amber">International EPC &amp; Procurement</Badge>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-extrabold uppercase tracking-tight text-white leading-[1.08]">
            Global Supply Chain<br/> Heavy Industrial <span class="text-amber-gold">Turnkey EPC</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed max-w-2xl">
            Swift Global Inc. executes high-consequence heavy equipment procurement, technical vendor prequalification, industrial plant upgrades, and turnkey EPC construction delivery across North America, the Middle East, and West Africa.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <Button href="/contact" variant="primary" size="lg">
              Submit Procurement RFP →
            </Button>
            <Button href="/services" variant="outline" size="lg">
              Explore EPC Capabilities
            </Button>
          </div>

          <!-- Standards & Compliance Ribbon -->
          <div class="pt-8 border-t border-obsidian-800">
            <div class="text-[11px] font-mono text-amber-gold uppercase tracking-architect mb-3">
              Operational Governance &amp; Standards:
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
              <div class="p-3 rounded-md bg-obsidian-900/80 border border-obsidian-750">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">GOVERNANCE</span>
                <span class="font-bold text-white">ISO 9001 QMS</span>
              </div>
              <div class="p-3 rounded-md bg-obsidian-900/80 border border-obsidian-750">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">INSPECTION</span>
                <span class="font-bold text-white">ASME &amp; API FAT</span>
              </div>
              <div class="p-3 rounded-md bg-obsidian-900/80 border border-obsidian-750">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">LOGISTICS</span>
                <span class="font-bold text-white">Incoterms 2020</span>
              </div>
              <div class="p-3 rounded-md bg-obsidian-900/80 border border-obsidian-750">
                <span class="text-amber-gold block text-[10px] uppercase font-bold">DELIVERY</span>
                <span class="font-bold text-white">Turnkey EPC</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Modern Glassmorphic Image Frame -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-md overflow-hidden p-2 bg-gradient-to-b from-amber-gold/30 via-obsidian-800 to-obsidian-900 shadow-2xl">
            <div class="relative rounded-md overflow-hidden aspect-[4/3] sm:aspect-[16/11]">
              <ResponsivePicture
                desktopSrc="/images/international-epc-site.webp"
                mobileSrc="/images/international-epc-site-mobile.webp"
                alt="Swift Global Industrial Petrochemical Complex"
                aspectRatio="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950/80 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Floating Metadata Badge -->
              <div class="absolute bottom-4 left-4 right-4 p-3 rounded-md bg-obsidian-950/90 backdrop-blur-md border border-amber-gold/30 flex items-center justify-between text-xs font-mono">
                <div>
                  <span class="text-amber-gold block text-[10px] uppercase">FLAGSHIP EPC PRACTICE</span>
                  <strong class="text-white">ASME / API / ISO 9001</strong>
                </div>
                <div class="text-right">
                  <span class="text-slate-400 block text-[10px]">GLOBAL SITES</span>
                  <span class="text-emerald-400 font-bold">18+ ACTIVE</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================
       CORE CAPABILITIES SECTION
       ========================================== -->
  <section class="py-20 lg:py-28 bg-obsidian-900 border-b border-obsidian-800 relative" aria-labelledby="capabilities-heading">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <SectionHeading
          index="01 //"
          title="Engineering Procurement &amp; EPC Capabilities"
          subtitle="End-to-end industrial solutions: from technical vendor prequalification and long-lead equipment procurement to site commissioning."
        />
        <Button href="/services" variant="secondary" size="md">
          All Services &amp; Specs →
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES.slice(0, 3).map((service) => (
          <article class="glass-card glass-card-hover rounded-md p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group">
            <div class="space-y-4">
              <div class="flex items-center justify-between font-mono">
                <span class="text-2xl font-display font-bold text-amber-gold">{service.number} //</span>
                <span class="text-[11px] px-2.5 py-0.5 rounded-md bg-amber-950/60 border border-amber-500/30 text-amber-300">
                  {service.keySpecs[0]?.label}: {service.keySpecs[0]?.value}
                </span>
              </div>

              <div class="rounded-md overflow-hidden aspect-[16/9]">
                <ResponsivePicture
                  desktopSrc={service.imageDesktop}
                  mobileSrc={service.imageMobile}
                  alt={service.title}
                  aspectRatio="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <h3 class="text-xl font-display font-bold uppercase tracking-tight text-white group-hover:text-amber-gold transition-colors">
                {service.title}
              </h3>

              <p class="text-sm text-slate-300 leading-relaxed font-sans">
                {service.shortDesc}
              </p>

              <ul class="space-y-2 pt-2 border-t border-obsidian-800 text-xs text-slate-300 font-mono">
                {service.features.slice(0, 3).map((feature) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-gold">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 mt-4">
              <a
                href={`/services#service-${service.number}`}
                class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-amber-gold hover:text-white transition-colors"
              >
                <span>Technical Details</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ==========================================
       FEATURED PROJECTS PORTFOLIO
       ========================================== -->
  <section class="py-20 lg:py-28 bg-obsidian-950 border-b border-obsidian-800" aria-labelledby="projects-heading">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <SectionHeading
          index="02 //"
          title="International Project Portfolio"
          subtitle="Demonstrated capital project execution across North America, the Middle East, and West Africa."
        />
        <Button href="/projects" variant="secondary" size="md">
          Explore All Projects →
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {PROJECTS.map((project) => (
          <article class="glass-card glass-card-hover rounded-md overflow-hidden group flex flex-col justify-between">
            <div class="relative aspect-[16/10] overflow-hidden">
              <ResponsivePicture
                desktopSrc={project.image}
                mobileSrc={project.imageMobile}
                alt={project.title}
                aspectRatio="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/20 to-transparent"></div>
              
              <!-- Sector Badge -->
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-md text-xs font-mono uppercase tracking-wider bg-obsidian-900/90 text-amber-gold border border-amber-gold/40 backdrop-blur-md">
                  {project.sector}
                </span>
              </div>

              <!-- Region Tag -->
              <div class="absolute top-4 right-4">
                <span class="px-3 py-1 rounded-md text-xs font-mono uppercase tracking-wider bg-black/80 text-slate-300 border border-slate-700 backdrop-blur-md">
                  {project.region}
                </span>
              </div>
            </div>

            <div class="p-6 sm:p-8 space-y-4 flex-grow flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center gap-2 font-mono text-xs text-slate-400">
                  <span>{project.location}</span>
                  <span>•</span>
                  <span>{project.year}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-display font-bold text-white group-hover:text-amber-gold transition-colors">
                  {project.title}
                </h3>

                <p class="text-sm text-slate-300 leading-relaxed font-sans">
                  {project.scope}
                </p>
              </div>

              <div class="pt-4 border-t border-obsidian-800 flex items-center justify-between text-xs font-mono">
                <span class="text-amber-gold font-semibold">{project.stats}</span>
                <a href="/projects" class="text-slate-300 hover:text-white flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  <span>Scope Review</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ==========================================
       GLOBAL OPERATIONAL HUBS
       ========================================== -->
  <section class="py-20 lg:py-28 bg-obsidian-900 border-b border-obsidian-800" aria-labelledby="footprint-heading">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      
      <SectionHeading
        index="03 //"
        title="Cross-Border Footprint &amp; Operational Hubs"
        subtitle="Strategic procurement centers and on-the-ground engineering representation spanning three key continents."
        align="left"
        class="mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {GLOBAL_REGIONS.map((region) => (
          <div class="glass-card rounded-md p-6 sm:p-8 space-y-5 border-l-4 border-l-amber-gold">
            <div class="flex items-center justify-between">
              <span class="text-3xl" aria-hidden="true">{region.flag}</span>
              <span class="font-mono text-xs text-amber-gold uppercase tracking-wider">{region.leadRole}</span>
            </div>

            <h3 class="text-2xl font-display font-bold text-white">
              {region.region}
            </h3>

            <div class="font-mono text-xs text-slate-400">
              {region.headquarters}
            </div>

            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              {region.description}
            </p>

            <div class="pt-4 border-t border-obsidian-800">
              <span class="text-[10px] font-mono uppercase text-slate-500 block mb-1">Key Operational Hubs:</span>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs text-slate-200">
                {region.keyHubs.map((hub) => (
                  <span class="px-2 py-0.5 rounded-md bg-obsidian-850 border border-obsidian-750">
                    {hub}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ==========================================
       BOTTOM RFP CONVERSION CTA
       ========================================== -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-obsidian-950 via-obsidian-900 to-obsidian-950 text-white relative overflow-hidden" aria-label="Procurement Request">
    <div class="absolute inset-0 bg-industrial-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto px-6 md:px-10 lg:px-12 text-center relative z-10 space-y-6">
      
      <Badge variant="amber">Ready to Source &amp; Deliver</Badge>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
        Accelerate Your Capital Project with Sovereign Procurement Power
      </h2>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-sans">
        Connect directly with our technical procurement directors and EPC managers to discuss equipment schedules, bid leveling, or turnkey facility construction.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/contact" variant="primary" size="lg">
          Submit Procurement RFP →
        </Button>
        <a
          href="tel:+15875663166"
          class="inline-flex items-center gap-2 px-6 py-4 rounded-md font-mono text-sm font-semibold text-slate-200 hover:text-white bg-obsidian-850 border border-obsidian-700 hover:border-amber-gold transition-all"
        >
          <span>TEL: +1 (587) 566-3166</span>
        </a>
      </div>

    </div>
  </section>

</Layout>
