---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import ProjectSideModal from '@/components/ui/ProjectSideModal.astro';
import { PROJECTS } from '@/data/companyData';

const categories = [
  { label: 'All', value: 'all', count: PROJECTS.length },
  { label: 'Energy & Petrochemical', value: 'Energy & Petrochemical', count: PROJECTS.filter((p) => p.sector === 'Energy & Petrochemical').length },
  { label: 'Marine & Logistics', value: 'Marine & Logistics', count: PROJECTS.filter((p) => p.sector === 'Marine & Logistics').length },
  { label: 'Heavy Industrial', value: 'Heavy Industrial', count: PROJECTS.filter((p) => p.sector === 'Heavy Industrial').length },
];
---

<Layout
  title="International EPC & Procurement Projects | Swift Global Inc."
  description="Review representative heavy industrial, marine logistics, and petrochemical facility projects executed by Swift Global Inc. across North America, the Middle East, and West Africa."
  activePath="/projects"
>
  <!-- Page Header -->
  <section class="bg-obsidian-950 text-white py-16 lg:py-24 border-b border-obsidian-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="amber">Capital Track Record</Badge>
          <span class="font-mono text-xs text-slate-400">Representative Contracts</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Delivered Projects &amp; Executed Scopes
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          From high-pressure refinery upgrades in the Arabian Gulf to deepwater terminal equipment logistics in West Africa, explore our global engineering and procurement execution.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Section with Category Tabs & 3-Column Card Grid -->
  <section class="py-16 lg:py-20 bg-obsidian-900 text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 space-y-10">
      
      <!-- Category Filter Tabs -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-obsidian-800">
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter projects by global industry sector">
          {categories.map((cat, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-filter={cat.value}
              class={`category-tab px-3 py-1.5 rounded-md font-mono text-[11px] font-semibold uppercase tracking-wider transition-all duration-200 flex items-center gap-2 border ${
                index === 0
                  ? 'bg-amber-gold text-obsidian-950 border-amber-gold font-bold shadow-amber-glow'
                  : 'bg-obsidian-850 text-slate-300 border-obsidian-750 hover:bg-obsidian-800 hover:text-white'
              }`}
            >
              <span>{cat.label}</span>
              <span
                class={`category-count px-1.5 py-0.5 rounded text-[10px] ${
                  index === 0 ? 'bg-obsidian-950/20 text-obsidian-950 font-bold' : 'bg-obsidian-800 text-slate-400'
                }`}
              >
                {cat.count}
              </span>
            </button>
          ))}
        </div>

        <p class="font-mono text-xs text-slate-400">
          Showing <span id="visible-projects-count">{PROJECTS.length}</span> projects
        </p>
      </div>

      <!-- 3-Column Projects Grid -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {PROJECTS.map((project) => (
          <article
            class="project-card glass-card glass-card-hover rounded-md overflow-hidden flex flex-col justify-between group cursor-pointer focus-visible:outline-2 focus-visible:outline-amber-gold"
            role="button"
            tabindex="0"
            data-project-trigger={project.id}
            data-category={project.sector}
            aria-label={`View full EPC and procurement specifications for ${project.title}`}
          >
            <!-- Card Image -->
            <div class="relative aspect-[16/10] overflow-hidden bg-obsidian-950">
              <ResponsivePicture
                desktopSrc={project.image}
                mobileSrc={project.imageMobile}
                alt={project.title}
                aspectRatio="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/30 to-transparent"></div>

              <!-- Badges on Image -->
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-mono uppercase bg-obsidian-900/90 text-amber-gold border border-amber-gold/40 backdrop-blur-md font-semibold">
                  {project.sector}
                </span>
              </div>
              <div class="absolute top-3 right-3">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-black/80 text-slate-300 border border-slate-700 backdrop-blur-md">
                  {project.region}
                </span>
              </div>
            </div>

            <!-- Compact Card Body -->
            <div class="p-4 sm:p-5 space-y-3 flex-grow flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center gap-1.5 font-mono text-xs text-slate-400">
                  <span>📍</span>
                  <span class="truncate">{project.location}</span>
                  <span>•</span>
                  <span>{project.year}</span>
                </div>

                <h2 class="text-base sm:text-[17px] font-display font-bold text-white group-hover:text-amber-gold transition-colors line-clamp-2 leading-snug">
                  {project.title}
                </h2>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-obsidian-950 text-white text-center border-t border-obsidian-800">
    <div class="max-w-4xl mx-auto px-6 md:px-10 lg:px-12 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold uppercase text-white">
        Bring Predictable Delivery to Your Upcoming Venture
      </h2>
      <p class="text-base text-slate-300 max-w-xl mx-auto font-sans leading-relaxed">
        Review your required equipment specifications and timeline with our senior project directors.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/contact" variant="primary" size="lg">
          Submit Procurement RFP →
        </Button>
        <Button href="/services" variant="secondary" size="lg">
          Explore Procurement Capabilities
        </Button>
      </div>
    </div>
  </section>

  <!-- Side Modal Component -->
  <ProjectSideModal projects={PROJECTS} />
</Layout>

<script>
  function setupCategoryFiltering() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const visibleCountEl = document.getElementById('visible-projects-count');

    if (!tabs.length || !cards.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        if (!filter) return;

        // Update active tab styles
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          const countBadge = t.querySelector('.category-count');

          if (isActive) {
            t.classList.remove('bg-obsidian-850', 'text-slate-300', 'border-obsidian-750', 'hover:bg-obsidian-800', 'hover:text-white');
            t.classList.add('bg-amber-gold', 'text-obsidian-950', 'border-amber-gold', 'font-bold', 'shadow-amber-glow');
            if (countBadge) {
              countBadge.classList.remove('bg-obsidian-800', 'text-slate-400');
              countBadge.classList.add('bg-obsidian-950/20', 'text-obsidian-950', 'font-bold');
            }
          } else {
            t.classList.remove('bg-amber-gold', 'text-obsidian-950', 'border-amber-gold', 'font-bold', 'shadow-amber-glow');
            t.classList.add('bg-obsidian-850', 'text-slate-300', 'border-obsidian-750', 'hover:bg-obsidian-800', 'hover:text-white');
            if (countBadge) {
              countBadge.classList.remove('bg-obsidian-950/20', 'text-obsidian-950', 'font-bold');
              countBadge.classList.add('bg-obsidian-800', 'text-slate-400');
            }
          }
        });

        // Filter cards and count visible
        let visibleCount = 0;
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCountEl) {
          visibleCountEl.textContent = visibleCount.toString();
        }
      });
    });
  }

  setupCategoryFiltering();
  document.addEventListener('astro:page-load', setupCategoryFiltering);
</script>
