---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES } from '@/data/companyData';
---

<Layout
  title="Procurement & Turnkey EPC Services | Swift Global Inc."
  description="Explore our specialized services: Engineering Procurement, Heavy Industrial Facility Modernization, Quality Oversight & FAT, Global Logistics, and Capital Project Management."
  activePath="/services"
>
  <!-- Page Header -->
  <section class="bg-obsidian-950 text-white py-16 lg:py-24 border-b border-obsidian-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="amber">Capabilities Matrix</Badge>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Procurement &amp; Turnkey EPC Services
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Integrated solutions combining high-specification material and equipment sourcing, rigorous QA/QC witness inspection, cross-border freight forwarding, and turnkey mechanical execution.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Deep Dive List -->
  <section class="py-20 lg:py-28 bg-obsidian-900 text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 space-y-16 md:space-y-24 lg:space-y-28">
      {SERVICES.map((service, idx) => (
        <article
          id={`service-${service.number}`}
          class={`grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}
        >
          <!-- Text Details -->
          <div class={`space-y-6 ${idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
            <h2 class="text-2xl sm:text-3xl font-display font-extrabold uppercase text-white">
              {service.title}
            </h2>

            <p class="text-base text-slate-300 font-sans leading-relaxed">
              {service.shortDesc}
            </p>

            <!-- Detailed Features -->
            <div class="space-y-3 pt-2">
              <h3 class="font-mono text-xs uppercase tracking-architect text-amber-gold">
                Scope Breakdown &amp; Deliverables:
              </h3>
              <ul class="space-y-2.5 font-sans text-sm text-slate-300">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <span class="text-amber-gold font-bold">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4">
              <Button href="/contact" variant="primary" size="md">
                Inquire About {service.title} →
              </Button>
            </div>
          </div>

          <!-- Image Frame -->
          <div class={`${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
            <div class="rounded-md overflow-hidden p-2 bg-gradient-to-b from-amber-gold/30 via-obsidian-800 to-obsidian-950 shadow-2xl">
              <div class="aspect-[16/11] rounded-md overflow-hidden">
                <ResponsivePicture
                  desktopSrc={service.imageDesktop}
                  mobileSrc={service.imageMobile}
                  alt={service.title}
                  aspectRatio="w-full h-full object-cover"
                />
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-obsidian-950 text-white text-center border-t border-obsidian-800">
    <div class="max-w-4xl mx-auto px-6 md:px-10 lg:px-12 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold uppercase text-white">
        Need a Tailored Equipment Procurement or EPC Scope?
      </h2>
      <p class="text-base text-slate-300 max-w-xl mx-auto font-sans">
        Submit your project technical specifications or bill of materials (BOM) for evaluation.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Submit Procurement RFP →
        </Button>
      </div>
    </div>
  </section>
</Layout>
