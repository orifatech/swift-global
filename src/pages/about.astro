---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { GLOBAL_REGIONS } from '@/data/companyData';
---

<Layout
  title="About Swift Global Inc. | International Procurement & Turnkey EPC"
  description="Discover Swift Global Inc., our global supply chain infrastructure, industrial facility modernization capabilities, and turnkey EPC delivery model across North America, the Middle East, and West Africa."
  activePath="/about"
>
  <!-- Page Header -->
  <section class="bg-obsidian-950 text-white py-16 lg:py-24 border-b border-obsidian-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="amber">Corporate Overview</Badge>
          <span class="font-mono text-xs text-slate-400">Toronto HQ • Middle East • West Africa</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          About Swift Global Inc.
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Operating at the nexus of strategic equipment manufacturing, global logistics staging, and industrial construction, Swift Global Inc. delivers turnkey execution for high-consequence capital projects.
        </p>
      </div>
    </div>
  </section>

  <!-- Industrial Philosophy & Capabilities -->
  <section class="py-20 lg:py-28 bg-obsidian-900 text-white border-b border-obsidian-800">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Copy -->
        <div class="lg:col-span-7 space-y-6">
          <SectionHeading
            index="01 //"
            title="Sourcing Integrity &amp; Turnkey Construction Governance"
            subtitle="Eliminating schedule drift and quality degradation across long-lead capital equipment and international construction sites."
          />

          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            Swift Global Inc. addresses the single most complex challenge in modern industrial construction: ensuring high-specification equipment arrives on time, fully verified, and ready for rapid installation. We maintain direct relationships with ISO 9001 and ASME-certified original equipment manufacturers (OEMs) worldwide.
          </p>

          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            From preliminary technical bid leveling and Factory Acceptance Testing (FAT) to port staging, maritime chartering, and on-site EPC installation, our engineers provide complete transparency and contractual certainty.
          </p>

          <!-- Core Capability Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 font-mono text-xs">
            <div class="p-4 rounded-md bg-obsidian-950 border border-obsidian-750 space-y-1">
              <span class="text-amber-gold font-bold block text-[11px] uppercase">01 / OEM PREQUALIFICATION</span>
              <p class="text-slate-300 font-sans text-xs">Rigorous audits of manufacturer plant capacity, QA/QC systems, and ASME/API certified welders.</p>
            </div>
            <div class="p-4 rounded-md bg-obsidian-950 border border-obsidian-750 space-y-1">
              <span class="text-amber-gold font-bold block text-[11px] uppercase">02 / FACTORY ACCEPTANCE TESTING</span>
              <p class="text-slate-300 font-sans text-xs">Full witness inspection, hydrostatic pressure testing, and dimensional verification prior to ex-works release.</p>
            </div>
            <div class="p-4 rounded-md bg-obsidian-950 border border-obsidian-750 space-y-1">
              <span class="text-amber-gold font-bold block text-[11px] uppercase">03 / INCOTERMS 2020 MASTERY</span>
              <p class="text-slate-300 font-sans text-xs">Complete risk management across CIF, DAP, and DDP contracts with heavy-lift chartering and customs bonded clearance.</p>
            </div>
            <div class="p-4 rounded-md bg-obsidian-950 border border-obsidian-750 space-y-1">
              <span class="text-amber-gold font-bold block text-[11px] uppercase">04 / TURNKEY EPC DELIVERY</span>
              <p class="text-slate-300 font-sans text-xs">Seamless transition from international supply chain directly into on-site mechanical and civil installation.</p>
            </div>
          </div>
        </div>

        <!-- Right: Image Frame -->
        <div class="lg:col-span-5 relative">
          <div class="rounded-md overflow-hidden p-2 bg-gradient-to-b from-amber-gold/30 via-obsidian-800 to-obsidian-950 shadow-2xl">
            <ResponsivePicture
              desktopSrc="/images/heavy-equipment-mfg.webp"
              mobileSrc="/images/heavy-equipment-mfg-mobile.webp"
              alt="Swift Global Quality Inspection"
              aspectRatio="aspect-[4/3] w-full"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- International Operating Footprint -->
  <section class="py-20 lg:py-28 bg-obsidian-950 text-white border-b border-obsidian-800">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl mb-16">
        <SectionHeading
          index="02 //"
          title="International Operational Reach"
          subtitle="Operating through key strategic hubs across North America, the Arabian Gulf, and West Africa."
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {GLOBAL_REGIONS.map((region) => (
          <div class="glass-card rounded-md p-6 sm:p-8 space-y-4">
            <div class="text-3xl">{region.flag}</div>
            <h3 class="text-2xl font-display font-bold text-white">{region.region}</h3>
            <div class="font-mono text-xs text-amber-gold">{region.headquarters}</div>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">{region.description}</p>
            <div class="pt-4 border-t border-obsidian-800 font-mono text-xs text-slate-400">
              <span class="text-slate-500 block text-[10px] uppercase mb-1">Key Hubs:</span>
              <span class="text-slate-200">{region.keyHubs.join(' • ')}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-obsidian-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-6 md:px-10 lg:px-12 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold uppercase text-white">
        Partner with Swift Global for Your Next Capital Procurement
      </h2>
      <p class="text-base text-slate-300 max-w-xl mx-auto font-sans">
        Review your technical specifications with our engineering procurement team.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Submit Procurement RFP →
        </Button>
      </div>
    </div>
  </section>
</Layout>
